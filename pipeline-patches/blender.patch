+#   a = motion.Anim(c); a.add(poses.layer("ground", 0, 200))       # hold the pose (with its life) over frames 0-200
+#
+# FIGURE poses swap in a dressed copy of the character (episode_scene does that, like the side-view walks);
+# MOVES are played by the character itself (no new drawing needed).
+import math
+from toon import *
+import motion
+from motion import curve, envelope
+
+FIGURE = ("ground", "kneel", "beanbag", "cannonball", "climb", "runto")
+MOVES = ("trip", "chin")
+ALL = FIGURE + MOVES
+
+
+def _fur(c):
+    """The leg colour (fur, or trousers) from the standing legs."""
+    for leg in c.legs.values():
+        for o in leg.children:
+            if "hex" in o:
+                return o["hex"]
+    return "#888888"
+
+
+def _cap(name, a, b, r, col, parent, z):
+    from cast import capsule
+    return shape(name, capsule(a[0], a[1], b[0], b[1], r), col, parent, z)
+
+
+def dress(c, pose):
+    """Add the drawn parts for `pose` to character c (body space: feet at 0, hips at 3.2) and hide the standing
+    legs if the pose replaces them. Returns {name: group} of the parts (some poses toggle between groups)."""
+    import cast
+    body = cast.body_of(c)
+    fur, dark = _fur(c), None
+    from toon import _hex_shift
+    dark = _hex_shift(fur, 0.8)
+    n = f"{c.name}_{pose}"
+    g = empty(n, body, (0, 0), 0.06)
+    parts = {"main": g}
+    if pose == "ground":  # cross-legged on the ground: shins crossed in the lap, knees out, feet tucked
+        y0 = GROUND_DROP  # the ground, in body space, once the hips are down
+        _cap(f"{n}_shinB", (1.85, y0 + 0.5), (-1.0, y0 + 0.22), 0.42, dark, g, -0.02)
+        _cap(f"{n}_shinA", (-1.85, y0 + 0.5), (1.0, y0 + 0.22), 0.42, fur, g, 0.0)
+        for s in (-1, 1):
+            shape(f"{n}_knee{s}", ell(2.0 * s, y0 + 0.62, 0.55, 0.48), fur, g, 0.01)
+            shape(f"{n}_foot{s}", ell(1.15 * s, y0 + 0.2, 0.55, 0.3), fur if s == 1 else dark, g, 0.02 if s == 1 else -0.03)
+    elif pose == "kneel":  # down on one knee: the near knee up toward us, the other knee on the ground
+        gy = KNEEL_DROP
+        _cap(f"{n}_thighL", (-0.72, 3.1), (-0.85, gy + 0.5), 0.43, fur, g, -0.1)
+        shape(f"{n}_kneeL", ell(-0.85, gy + 0.42, 0.52, 0.42), fur, g, -0.08)
+        _cap(f"{n}_shinR", (0.95, 2.95), (1.0, gy + 0.55), 0.41, fur, g, 0.0)
+        shape(f"{n}_kneeR", ell(0.92, 3.05, 0.6, 0.5), fur, g, 0.02)
+        shape(f"{n}_footR", ell(1.25, gy + 0.36, 0.78, 0.38), fur, g, 0.03)
+    elif pose == "cannonball":  # knees tucked up to the chest, shins down in front, feet together
+        _cap(f"{n}_shinL", (-0.8, 4.6), (-0.6, 3.1), 0.45, fur, g, 0.3)
+        _cap(f"{n}_shinR", (0.8, 4.6), (0.6, 3.1), 0.45, fur, g, 0.31)
+        for s in (-1, 1):
+            shape(f"{n}_knee{s}", ell(0.85 * s, 4.75, 0.68, 0.6), fur, g, 0.32)
+            shape(f"{n}_foot{s}", ell(0.7 * s, 2.9, 0.68, 0.36), fur, g, 0.33)
+    elif pose == "climb":  # one knee up (stepping up onto something), the other leg straight
+        _cap(f"{n}_shinL", (-0.8, 3.55), (-0.85, 1.75), 0.41, fur, g, 0.0)
+        shape(f"{n}_kneeL", ell(-0.78, 3.6, 0.58, 0.5), fur, g, 0.02)
+        shape(f"{n}_footL", ell(-1.0, 1.55, 0.72, 0.36), fur, g, 0.03)
+    elif pose == "runto":  # running at us: one knee up toward the camera, the other leg pushing off; two drawings
+        for k, s in (("A", 1), ("B", -1)):
+            gk = empty(f"{n}_{k}", g, (0, 0), 0.0)
+            _cap(f"{n}_{k}_shinUp", (0.72 * s, 2.7), (0.75 * s, 1.35), 0.41, fur, gk, 0.0)
+            shape(f"{n}_{k}_kneeUp", ell(0.72 * s, 2.75, 0.6, 0.5), fur, gk, 0.02)
+            shape(f"{n}_{k}_footUp", ell(0.85 * s, 1.15, 0.7, 0.36), fur, gk, 0.03)
+            _cap(f"{n}_{k}_legDown", (-0.72 * s, 3.1), (-0.82 * s, 0.4), 0.43, dark, gk, -0.1)
+            shape(f"{n}_{k}_footDown", ell(-1.0 * s, 0.32, 0.6, 0.3), dark, gk, -0.09)
+            parts[k] = gk
+        set_visible(parts["B"], False)
+    elif pose == "beanbag":  # lying back: legs out in front, one knee up a little
+        _cap(f"{n}_legL", (-0.72, 3.1), (-1.0, 0.6), 0.43, fur, g, -0.1)
+        shape(f"{n}_footL", ell(-1.1, 0.38, 0.72, 0.38), fur, g, -0.09)
+        _cap(f"{n}_thighR", (0.72, 3.1), (1.35, 1.85), 0.43, fur, g, -0.1)
+        _cap(f"{n}_shinR", (1.35, 1.85), (1.25, 0.55), 0.41, fur, g, -0.1)
+        shape(f"{n}_kneeR", ell(1.35, 1.9, 0.5, 0.45), fur, g, -0.08)
+        shape(f"{n}_footR", ell(1.45, 0.38, 0.72, 0.38), fur, g, -0.09)
+    if pose in ("ground", "kneel", "cannonball", "runto", "beanbag"):
+        for leg in c.legs.values():
+            leg.scale = (1e-4, 1e-4, 1)
+    elif pose == "climb":
+        c.legs[-1].scale = (1e-4, 1e-4, 1)
+    c.extras["pose"] = pose
+    c.extras["pose_parts"] = parts
+    return parts
+
+
+GROUND_DROP = 2.6   # sitting on the ground: how far the hips come down (character units)
+KNEEL_DROP = 1.3    # down on one knee
+
+
+def beanbag(name, parent, loc, s=1.0, z=-1.0):
+    """A beanbag to lie back on (for reference sheets; the apartment painting has its own)."""
+    g = empty(name, parent, loc, z)
+    g.scale = (s, s, 1)
+    shape(f"{name}_bag", [(-3.4, 0.0, "s"), (3.6, 0.0, "s"), (4.2, 1.6), (3.6, 4.0), (1.5, 6.4), (-0.8, 6.6), (-3.0, 5.2),
+                          (-4.0, 2.6)], "#A9573F", g, 0.0)
+    stroke(f"{name}_seam", [(-1.5, 5.6), (0.5, 4.2), (2.8, 3.9)], 0.07, "#7A3A28", g, 0.01)
+    return g
+
+
+def layer(pose, f0, f1, side=1, ramp=5):
+    """The acting for a pose over [f0, f1]: a function frame -> channels (motion.Anim.add). Figure poses hold
+    still apart from their own life (breathing, blinks, talking come from the Anim); moves play out in time."""
+    e = lambda fr: envelope(fr, f0, f1, ramp)
+    if pose == "ground":
+        return lambda fr: None if not (f0 <= fr <= f1) else {
+            "y": -GROUND_DROP, "arm1": 24, "arm-1": 24, "elbow1": 38, "elbow-1": 38, "hand1": "paw", "hand-1": "paw"}
+    if pose == "kneel":
+        return lambda fr: None if not (f0 <= fr <= f1) else {
+            "y": -KNEEL_DROP, "lean": -3, "arm1": 12, "elbow1": 55, "arm-1": 14, "elbow-1": 10, "hand1": "paw"}
+    if pose == "beanbag":  # lying back, paws behind the head
+        return lambda fr: None if not (f0 <= fr <= f1) else {
+            "rot": -50, "y": 0.95, "x": -1.85, "arm1": 165, "arm-1": 165, "elbow1": 120, "elbow-1": 120,
+            "hand1": "paw", "hand-1": "paw", "head_rot": 22}
+    if pose == "climb":  # reaching up for the next hold, pulling, then reaching with the other paw
+        def L(fr):
+            if not (f0 <= fr <= f1):
+                return None
+            ph = (fr - f0) / 26.0
+            k = 0.5 + 0.5 * math.sin(ph * math.pi)
+            return {"y": 0.7 + 0.25 * k, "arm1": 150 + 18 * k, "elbow1": 20 - 10 * k, "hand1": "open",
+                    "arm-1": 70 - 25 * k, "elbow-1": 80, "hand-1": "fist", "lean": 4 * math.sin(ph * math.pi), "head_y": 0.15}
+        return L
+    if pose == "runto":  # running at the camera: arms pumping, a bob on every step
+        def L(fr):
+            if not (f0 <= fr <= f1):
+                return None
+            ph = (fr - f0) / 6.0 * math.pi
+            return {"y": 0.35 * abs(math.sin(ph)), "lean": 3 * math.sin(ph), "arm1": 30 + 35 * math.sin(ph), "arm-1": 30 - 35 * math.sin(ph),
+                    "elbow1": 95, "elbow-1": 95, "hand1": "fist", "hand-1": "fist", "sq": 1 + 0.03 * math.cos(2 * ph)}
+        return L
+    if pose == "cannonball":  # crouch, spring up, tuck, drop
+        up, peak, down = f0 + 8, f0 + 8 + 10, f0 + 8 + 20
+        def L(fr):
+            if not (f0 <= fr <= f1):
+                return None
+            y = curve(fr, [(f0, 0, "linear"), (f0 + 6, -0.6, "out"), (up, 0.2, "out"), (peak, 3.4, "out"), (down, -1.0, "in")])
+            return {"y": y, "arm1": 8, "arm-1": 8, "elbow1": -100, "elbow-1": -100, "hand1": "paw", "hand-1": "paw",
+                    "rot": 6 * math.sin((fr - f0) * 0.35), "sq": curve(fr, [(f0, 1, "linear"), (f0 + 6, 0.88, "out"), (up, 1.12, "out"), (peak, 1.0, "smooth")])}
+        return L
+    if pose == "trip":  # catches a foot, pitches over sideways, arms flung out, then rights himself
+        hit, hold = f0 + 4, max(f0 + 14, f1 - 10)
+        def L(fr):
+            if not (f0 - 2 <= fr <= f1 + 2):
+                return None
+            k = curve(fr, [(f0, 0, "linear"), (hit, 0.35, "in"), (hit + 6, 1.0, "out"), (hold, 1.0, "linear"), (f1, 0, "smooth")])
+            return {"rot": 34 * k * side, "y": 0.35 * k, "x": -0.5 * k * side, "stride": 22 * k,
+                    "arm1": 70 + 60 * k, "arm-1": 70 + 60 * k, "elbow1": 15, "elbow-1": 15, "hand1": "open", "hand-1": "open",
+                    "head_rot": -8 * k * side, "sq": 1 - 0.04 * k}
+        return L
+    if pose == "chin":  # chin in both paws, elbows in, head sinking a little
+        return lambda fr: None if not (f0 - ramp <= fr <= f1 + ramp) else {
+            "face1": e(fr), "face-1": e(fr), "face_y": -2.15 * e(fr), "head_y": -0.2 * e(fr), "head_rot": 5 * e(fr),
+            "hand1": "paw", "hand-1": "paw", "lean": 2 * e(fr)}
+    raise ValueError(f"poses: unknown pose {pose!r} ({', '.join(ALL)})")
+
+
+def run_frame(c, fr, f0):
+    """runto: which running drawing shows at frame fr (they alternate every 6 frames, matching layer())."""
+    parts = c.extras.get("pose_parts", {})
+    if "A" in parts:
+        a_on = int((fr - f0) / 6) % 2 == 0
+        set_visible(parts["A"], a_on, fr)
+        set_visible(parts["B"], not a_on, fr)
+
+
+FACE = {"ground": "happy", "kneel": "determined", "beanbag": "soft", "cannonball": "hype", "climb": "determined",
+        "runto": "yelling", "trip": "shocked", "chin": "sad"}
