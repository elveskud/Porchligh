+#!/usr/bin/env python3
+"""Depth layers for a painted Porchlight set: split the 4K plate into far / mid / near layers, so the camera moves
+*through* the set (far things slide slower than the ground the cast stands on, near things faster).
+Full guide: Porchlight DEPTH_LAYERS.md. Needs only Python 3 with Pillow and numpy (doctor.py checks both).
+
+Two ways in:
+  A) From Gemini (best). F3 in GEMINI_PROMPTS.md makes three pictures of one set painting:
+       art/gemini/sets/<img>_far.jpg    the painting with everything near removed and the sky/hills painted in
+       art/gemini/sets/<img>_mid.png    only the middle ground (water, dock, beach), everything else pure magenta
+       art/gemini/sets/<img>_near.png   only the nearest things (grass, rocks at the bottom edge), the rest magenta
+     python3 depth_layers.py lake_day_v3
+  B) No Gemini pictures: cut the painting at two heights (painting px, 1024x572 space like every set JSON):
+     python3 depth_layers.py lake_day_v3 --bands 330,500     (above 330 = far, 330-500 = mid, below 500 = near)
+
+What it does (A): Gemini repaints, so its pictures are only trusted for *shapes*, never for colours. Each one is
+aligned to the plate (scale + shift search), the magenta is keyed out to a mask, and the layers are cut from the
+plate's own pixels with those masks. Gemini's pixels are used only where the plate has nothing: behind the mid
+layer (in the far layer) and behind the near layer (in the mid layer), colour-matched to the plate first.
+
+Writes art/hd/sets/layers/<img>_far.png, _mid.png, _near.png (RGBA, plate size), <img>_layers.png (a check sheet)
+and <img>_parallax.gif (a camera pan), and adds "layers" to art/hd/sets/<img>.json so episodes use them.
+"""
+import argparse, json, os, sys
+import numpy as np
+from PIL import Image, ImageFilter
+
+PORCHLIGHT = os.environ.get("PORCHLIGHT_DIR", os.path.expanduser("~/Desktop/Porchlight"))
+SETS = os.path.join(PORCHLIGHT, "art/hd/sets")
+GEMINI = os.path.join(PORCHLIGHT, "art/gemini/sets")
+PW, PH = 1024, 572           # painting pixel space used by every set JSON
+FACTORS = {"far": 0.82, "near": 1.22}   # parallax: <1 trails the camera (far), >1 runs ahead of it (near)
+MAGENTA = np.array([255, 0, 255], np.float32)
+KEY_IN, KEY_OUT = 70.0, 150.0   # RGB distance from magenta: below KEY_IN = fully keyed out, above KEY_OUT = solid
+
+
+def find(base, names):
+    for n in names:
+        for ext in (".png", ".jpg", ".jpeg", ".webp"):
+            p = os.path.join(base, n + ext)
+            if os.path.exists(p):
+                return p
+    return None
+
+
+def load_rgb(path, size=None):
+    """Gemini redraws the whole frame at its own size (often 1408x768 or 1344x768, not exactly 16:9) with the same
+    composition, so stretch it to the plate's size; align() then fixes what's left."""
+    im = Image.open(path).convert("RGB")
+    return im if size is None else im.resize(size, Image.LANCZOS)
+
+
+def key_magenta(a):
+    """Float alpha (0..1) from an RGB array: magenta (and Gemini's slightly-off magenta) is transparent."""
+    d = np.sqrt(((a.astype(np.float32) - MAGENTA) ** 2).sum(-1))
+    t = np.clip((d - KEY_IN) / (KEY_OUT - KEY_IN), 0, 1)
+    return t * t * (3 - 2 * t)
+
+
+def warp(im, s, dx, dy, asp=1.0):
+    """Scale `im` by s (and its width by a further asp) about its centre and shift it by (dx, dy) pixels."""
+    W, H = im.size
+    sx, sy = s * asp, s
+    cx, cy = W / 2, H / 2  # PIL's affine maps each output pixel back to the input: x_in = cx + (x - cx - dx) / sx
+    return im.transform((W, H), Image.AFFINE, (1 / sx, 0, cx - (cx + dx) / sx, 0, 1 / sy, cy - (cy + dy) / sy),
+                        resample=Image.BILINEAR, fillcolor=(255, 0, 255))  # the uncovered border: magenta, i.e. empty
+
+
+def align(plate, layer, weight, label, start=None):
+    """Find the scale, width stretch and shift that put Gemini's `layer` on top of the plate: a coarse-to-fine search
+    minimising the mean colour difference over the pixels `weight` (0..1, plate-sized) says to compare
+    (weight None: a magenta cut-out, compared wherever it has paint once moved).
+    Returns (s, dx, dy, asp, err) in plate pixels; err is the mean RGB difference per channel (0-255) at the fit."""
+    best = start or (1.0, 0.0, 0.0, 1.0)
+    # start given (a thin layer, e.g. grass: Gemini moves all three pictures alike): skip the coarse search
+    levels = ((480, None, 6, 1), (960, None, 3, 1)) if start else \
+        ((192, np.arange(0.94, 1.0601, 0.01), 12, 1), (480, None, 4, 1), (960, None, 3, 1))
+    for width, scales, reach, step in levels:
+        k = width / plate.width
+        sz = (width, round(plate.height * k))
+        P = np.asarray(plate.resize(sz, Image.BILINEAR), np.float32)
+        Wt = None if weight is None else \
+            np.asarray(Image.fromarray((weight * 255).astype(np.uint8)).resize(sz, Image.BILINEAR), np.float32) / 255
+        Ls = layer.resize(sz, Image.BILINEAR)
+        s0, dx0, dy0, a0 = best
+        cands = [(s, 1.0) for s in scales] if scales is not None else \
+            [(s0 + d, a0 + da) for d in (-0.004, -0.002, 0, 0.002, 0.004) for da in ((-0.006, 0, 0.006) if width == 480 else (0,))]
+        top = (1e9, best)
+        if start:  # the starting fit's own score, so a noisy search can't wander off a good start
+            A0 = np.asarray(warp(Ls, s0, dx0 * k, dy0 * k, a0), np.float32)
+            w0 = solid_core(A0) if Wt is None else Wt * (key_magenta(A0) > 0.5)
+            if w0.sum() >= 60:
+                top = (0.97 * (np.minimum(np.abs(A0 - P).mean(-1), 40.0) * w0).sum() / w0.sum(), best)
+        for s, asp in cands:
+            for ix in range(-reach, reach + 1, step):
+                for iy in range(-reach, reach + 1, step):
+                    dx, dy = dx0 * k + ix, dy0 * k + iy
+                    A = np.asarray(warp(Ls, s, dx, dy, asp), np.float32)
+                    # a cut-out is compared only inside its solid paint after the move: a blended edge pixel (magenta
+                    # mixed with paint) reads as solid pink, and a thin layer (grass) is nearly all edge
+                    w_ = solid_core(A) if Wt is None else Wt * (key_magenta(A) > 0.5)
+                    if w_.sum() < 60:  # too thin to measure at this size: keep the starting fit
+                        continue
+                    # capped per pixel: a few wildly wrong pixels (a border, something Gemini added) can't outvote the rest
+                    e = (np.minimum(np.abs(A - P).mean(-1), 40.0) * w_).sum() / max(1.0, w_.sum())
+                    if e < top[0]:
+                        top = (e, (s, dx / k, dy / k, asp))
+        best = top[1]
+        err = top[0]
+    print(f"  {label}: scale {best[0]:.3f} (width x{best[3]:.3f}), shift ({best[1]:+.0f}, {best[2]:+.0f}) px, mean difference {err:.1f}")
+    if err > 28:
+        print(f"  WARNING {label}: Gemini moved or repainted too much (difference {err:.0f}); regenerate it "
+              f"(say 'exactly the same size and position as image 1') or use --bands")
+    return best + (err,)  # (s, dx, dy, asp, err)
+
+
+def inpaint(rgb, known):
+    """Fill the unknown pixels (known False) from the colours around them: blurred known pixels divided by the
+    blurred mask, at growing radii, coarse fills only where finer ones found nothing (normalised convolution)."""
+    out = rgb.astype(np.float32).copy()
+    k = known.astype(np.float32)
+    todo = ~known
+    small = lambda a, r: np.asarray(Image.fromarray(a).filter(ImageFilter.GaussianBlur(r)), np.float32)
+    for r in (4, 12, 40, 120):
+        wk = small((k * 255).astype(np.uint8), r) / 255
+        got = (wk > 0.02) & todo
+        if not got.any():
+            continue
+        for c in range(3):
+            num = small(np.clip(out[..., c] * k, 0, 255).astype(np.uint8), r)
+            out[..., c][got] = (num[got] / np.maximum(wk[got], 1e-3))
+        k = np.where(got, 1.0, k)
+        todo &= ~got
+    return np.clip(out, 0, 255)
+
+
+def to_edges(mask, valid, reach=80):
+    """A fitted layer can leave a sliver along the frame edge where Gemini's picture didn't reach: carry the mask
+    out to the edge from the nearest pixels it does cover."""
+    m = mask.copy()
+    hole = ~valid
+    grow = Image.fromarray((m * 255).astype(np.uint8))
+    for _ in range(reach // 8):
+        grow = grow.filter(ImageFilter.MaxFilter(17))
+        g = np.asarray(grow, np.float32) / 255
+        m = np.where(hole, np.maximum(m, g), m)
+    return m
+
+
+def solid_core(A):
+    """1 where a keyed picture is solid paint at least a pixel in from any edge, else 0."""
+    m = Image.fromarray(((key_magenta(A) > 0.99) * 255).astype(np.uint8)).filter(ImageFilter.MinFilter(3))
+    return np.asarray(m, np.float32) / 255
+
+
+def match_colours(src, ref, where):
+    """Shift src's per-channel mean and spread to ref's over the pixels `where` (bool), so Gemini's fill matches."""
+    out = src.astype(np.float32).copy()
+    if where.sum() < 500:
+        return out
+    for c in range(3):
+        a, b = src[..., c][where].astype(np.float32), ref[..., c][where].astype(np.float32)
+        out[..., c] = (out[..., c] - a.mean()) / max(1e-3, a.std()) * b.std() + b.mean()
+    return np.clip(out, 0, 255)
+
+
+def soften(mask, grow, feather):
+    """Clean a 0..1 mask: drop specks, grow it by `grow` px (a little of the background rides along, so no gap of
+    sky shows round an edge when the layers slide), and feather the edge."""
+    m = Image.fromarray((mask * 255).astype(np.uint8))
+    m = m.filter(ImageFilter.MinFilter(3)).filter(ImageFilter.MaxFilter(3))   # specks out
+    if grow:
+        m = m.filter(ImageFilter.MaxFilter(2 * grow + 1))
+    if feather:
+        m = m.filter(ImageFilter.GaussianBlur(feather))
+    return np.asarray(m, np.float32) / 255
+
+
+def mirror_fill(a, cut_y, down=True):
+    """Fill everything below (down) / above row cut_y by mirroring the rows next to it: the band split's stand-in
+    for the ground hidden behind a nearer layer (only a sliver of it ever shows)."""
+    out = a.copy()
+    H = a.shape[0]
+    rows = range(cut_y, H) if down else range(0, cut_y)
+    for y in rows:
+        src = 2 * cut_y - y - 1 if down else 2 * cut_y - y
+        out[y] = a[min(H - 1, max(0, src))]
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("img", help="the set painting's name, as in locations.PLATE_SETS img= (e.g. lake_day_v3)")
+    ap.add_argument("--bands", help="no Gemini pictures: far/mid and mid/near cut heights in painting px, e.g. 330,500")
+    ap.add_argument("--near-behind", action="store_true", help="the near layer sits behind the cast (it includes "
+                    "ground they stand on); default: in front, like foreground plants")
+    ap.add_argument("--far", type=float, default=FACTORS["far"], help="far parallax factor (default 0.82)")
+    ap.add_argument("--near", type=float, default=FACTORS["near"], help="near parallax factor (default 1.22)")
+    a = ap.parse_args()
+
+    plate_path = os.path.join(SETS, a.img + ".png")
+    if not os.path.exists(plate_path):
+        sys.exit(f"no plate {plate_path} (set PORCHLIGHT_DIR to the Porchlight folder)")
+    plate = Image.open(plate_path).convert("RGB")
+    W, H = plate.size
+    P = np.asarray(plate, np.float32)
+    out_dir = os.path.join(SETS, "layers")
+    os.makedirs(out_dir, exist_ok=True)
+    print(f"{a.img}: plate {W}x{H}")
+
+    if a.bands:
+        y1, y2 = (int(v) * H // PH for v in a.bands.split(","))
+        ramp = lambda y0: np.clip((np.arange(H)[:, None] - y0) / (0.006 * H) + 0.5, 0, 1) * np.ones((1, W))
+        mid_m, near_m = ramp(y1), ramp(y2)
+        far_rgb = mirror_fill(P, y1 + int(0.01 * H))
+        mid_rgb = mirror_fill(P, y2 + int(0.01 * H))
+        mid_a = mid_m
+        print(f"  bands: far above {y1}px, near below {y2}px (plate px)")
+    else:
+        g_far, g_mid, g_near = (find(GEMINI, [f"{a.img}_{k}"]) for k in ("far", "mid", "near"))
+        missing = [k for k, p in (("far", g_far), ("mid", g_mid), ("near", g_near)) if not p]
+        if missing:
+            sys.exit(f"missing Gemini pictures in {GEMINI}: {', '.join(a.img + '_' + k for k in missing)} "
+                     f"(GEMINI_PROMPTS.md F3), or use --bands")
+        layers, fit = {}, None
+        white = Image.new("RGB", (W, H), (255, 255, 255))
+        for k, p in (("mid", g_mid), ("near", g_near)):
+            im = load_rgb(p, (W, H))
+            s, dx, dy, asp, _ = align(plate, im, None, k, start=fit)
+            fit = fit or (s, dx, dy, asp)
+            im = warp(im, s, dx, dy, asp)
+            valid = np.asarray(warp(white, s, dx, dy, asp))[..., 1] > 128  # where Gemini's picture reaches
+            layers[k] = (np.asarray(im, np.float32), to_edges(key_magenta(np.asarray(im)), valid))
+        near_m = soften(layers["near"][1], grow=4, feather=1.5)
+        mid_only = soften(layers["mid"][1], grow=4, feather=1.5)
+        mid_m = np.maximum(mid_only, near_m)      # the mid layer covers what's behind the near layer too
+        covered = mid_m > 0.02
+        im = load_rgb(g_far, (W, H))
+        s, dx, dy, asp, _ = align(plate, im, (~covered).astype(np.float32), "far", start=fit)
+        far_g = np.asarray(warp(im, s, dx, dy, asp), np.float32)
+        edge = key_magenta(far_g) < 0.5
+        far_g[edge] = P[edge]  # a sliver of border uncovered by the fit: the painting's own pixels
+        far_g = match_colours(far_g, P, ~covered)
+        w = soften(covered.astype(np.float32), grow=10, feather=6)[..., None]
+        far_rgb = P * (1 - w) + far_g * w           # the plate where it's seen, Gemini's sky/hills behind the rest
+        # the ground behind the near things: only slivers of it ever show as they slide, so it's filled from the
+        # painting's own ground around them (Gemini's mid picture is often empty or redrawn there)
+        free = soften((near_m > 0.02).astype(np.float32), grow=14, feather=0) < 0.02  # clear of their outlines
+        mid_g = inpaint(P, free)
+        wn = soften((near_m > 0.02).astype(np.float32), grow=8, feather=4)[..., None]
+        mid_rgb = P * (1 - wn) + mid_g * wn         # the plate, and Gemini's ground where the near things stand
+        mid_a = mid_m
+        for k, m in (("mid", mid_only), ("near", near_m)):
+            print(f"  {k}: covers {100 * (m > 0.5).mean():.0f}% of the picture")
+
+    def save(name, rgb, alpha=None):
+        arr = np.clip(rgb, 0, 255).astype(np.uint8)
+        im = Image.fromarray(arr, "RGB")
+        if alpha is not None:
+            im.putalpha(Image.fromarray((np.clip(alpha, 0, 1) * 255).astype(np.uint8)))
+        p = os.path.join(out_dir, f"{a.img}_{name}.png")
+        im.save(p, optimize=True)
+        return im
+
+    far_im = save("far", far_rgb)
+    mid_im = save("mid", mid_rgb, mid_a)
+    near_im = save("near", P, near_m)
+
+    # check sheet: the plate, then each layer on a checkerboard (holes and halos show up at once)
+    tw, th = 960, 540
+    sheet = Image.new("RGB", (tw * 2, th * 2), "white")
+    chk = Image.fromarray(((np.indices((th, tw)) // 24).sum(0) % 2 * 60 + 150).astype(np.uint8)).convert("RGB")
+    for i, (lbl, im) in enumerate((("plate", plate), ("far", far_im), ("mid", mid_im), ("near", near_im))):
+        bg = chk.copy()
+        sm = im.resize((tw, th), Image.LANCZOS)
+        bg.paste(sm, (0, 0), sm if sm.mode == "RGBA" else None)
+        sheet.paste(bg, ((i % 2) * tw, (i // 2) * th))
+    sheet.save(os.path.join(out_dir, f"{a.img}_layers.png"))
+
+    # parallax preview: a camera pan left and right across the set
+    frames = []
+    pw, ph = 640, 360
+    f_, m_, n_ = (im.resize((pw, ph), Image.LANCZOS) for im in (far_im, mid_im, near_im))
+    for t in range(32):
+        cam = 28 * np.sin(2 * np.pi * t / 32)     # camera x, preview px
+        fr = Image.new("RGB", (pw, ph))
+        for im, fac in ((f_, a.far), (m_, 1.0), (n_, a.near)):
+            off = int(round(-cam * fac))
+            fr.paste(im, (off, 0), im if im.mode == "RGBA" else None)
+        frames.append(fr.crop((32, 0, pw - 32, ph)))
+    frames[0].save(os.path.join(out_dir, f"{a.img}_parallax.gif"), save_all=True, append_images=frames[1:], duration=60, loop=0)
+
+    spec_path = os.path.join(SETS, a.img + ".json")
+    spec = json.load(open(spec_path)) if os.path.exists(spec_path) else {}
+    spec["layers"] = {"far": a.far, "near": a.near, "near_behind": bool(a.near_behind)}
+    json.dump(spec, open(spec_path, "w"), indent=None)
+    print(f"  wrote {out_dir}/{a.img}_far|mid|near.png, the check sheet {a.img}_layers.png and {a.img}_parallax.gif;")
+    print(f"  {a.img}.json now has \"layers\" (episodes with \"act\" use them; delete the key to switch them off)")
+
+
+if __name__ == "__main__":
+    main()
