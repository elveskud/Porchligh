+++ b/characters/poseref.py
@@ -0,0 +1,38 @@
+# Reference sheet for the drawn poses (poses.py): every pose for one character -> refs/poses_<name>.png
+#   Blender --background --python poseref.py        (ONLY=pip for one character)
+import os, sys
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+from toon import *
+import roster, motion, poses
+
+OUT = os.path.join(HERE, "refs")
+ONLY = os.environ.get("ONLY")
+motion.RICH = True
+GAP = 9.0
+SHOW = [("ground", 20), ("kneel", 20), ("beanbag", 20), ("chin", 20), ("trip", 14), ("cannonball", 18), ("climb", 13), ("runto", 9)]
+
+for who in ("riot", "bash", "pip", "rocco"):
+    if ONLY and who != ONLY:
+        continue
+    sc = reset()
+    setup_render(sc, 3200, 1800, bg="#FFFFFF")
+    for i, (pose, fr) in enumerate(SHOW):
+        x, y = -GAP * 1.5 + (i % 4) * GAP, 16 if i < 4 else 0
+        if pose == "beanbag":
+            poses.beanbag(f"bag{i}", None, (x + 0.6, y - 0.2), 0.95)
+        c = roster.make(who)
+        c.root.location = (x, y, 0)
+        if pose in poses.FIGURE:
+            poses.dress(c, pose)
+        a = motion.Anim(c, idle=False)
+        a.expr(0, poses.FACE[pose])
+        a.add(poses.layer(pose, 30 - fr, 90 - fr))  # each pose shown at its best frame
+        a.bake(0, 40)
+        if pose == "runto":
+            poses.run_frame(c, 30, 30 - fr)
+        text(f"t{i}", pose.upper(), 0.9, "#666666", None, (x, y - 1.6), 1)
+        stroke(f"g{i}", [(x - 4, y), (x + 4, y)], 0.05, "#BBBBBB", None, -1.5)
+    camera(sc, 0, 13.0, 31)
+    still(sc, os.path.join(OUT, f"poses_{who}.png"), 30)
+print("pose refs done")
