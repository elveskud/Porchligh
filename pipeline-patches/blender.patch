+# ---------- walk and run cycles ----------
+# (stride deg, knee bend deg, bob, arm swing deg, lean deg, head nod deg) per character, from roster weights:
+# Riot bouncy and confident, Bash heavy and wide, Pip quick little steps, Rocco loose and slouched.
+STYLE = {"riot": (26, 48, 0.22, 26, -2, 3), "bash": (24, 34, 0.12, 32, 4, 2),
+         "pip": (18, 42, 0.16, 18, 3, 4), "rocco": (16, 26, 0.07, 10, 9, 1)}
+RUN = (1.65, 1.9, 1.8, 1.9)  # run multipliers: stride, knee, bob, arms (plus a forward lean, elbows bent)
+
+
+def walk_pose(c, p, run=False, frame=None):
+    """Pose a side-view character at phase p (0..1) of a two-step cycle. p=0: contact, near foot forward;
+    1/8 down; 2/8 passing; 3/8 up; 4/8 contact with the far foot forward, and so on. The lower foot stays on
+    the ground (y=0). frame: key it there."""
+    who = c.name.split(".")[0]
+    S, K, B, A, lean, nod = STYLE.get(who, (20, 36, 0.14, 18, 2, 2))
+    if run:
+        S, K, B, A = S * RUN[0], K * RUN[1], B * RUN[2], A * RUN[3]
+        lean += 12
+    th = 2 * math.pi * p
+    body = c.extras["body"]
+    for s in (1, -1):
+        ph = th if s == 1 else th + math.pi
+        hip = S * math.cos(ph)
+        swing = -math.sin(ph)                              # > 0 while this leg swings forward
+        knee = K * max(0.0, swing) ** 1.2 + 0.25 * K * max(0.0, math.sin(2 * ph)) * (math.cos(ph) > 0)
+        if run:
+            knee = K * (0.35 + 0.65 * max(0.0, swing))
+        toe = 14 * max(0.0, math.cos(ph)) ** 4 - 22 * max(0.0, -math.cos(ph)) ** 6 * (math.sin(ph) < 0.3)
+        leg = c.legs[s]
+        leg.rotation_euler.z = rad(hip)
+        c.extras[f"knee{s}"].rotation_euler.z = rad(-knee)
+        c.extras[f"ankle{s}"].rotation_euler.z = rad(-(hip - knee) + toe)
+        arm = -A * math.cos(ph)
+        c.arms[s].rotation_euler.z = rad(arm + (6 if run else 0))
+        c.elbows[s].rotation_euler.z = rad((85 if run else 8) + (0.6 * A * max(0.0, -math.cos(ph)) if not run else 0))
+    lift = (B * 2.2 * max(0.0, math.sin(2 * th + 0.4))) if run else 0.0  # the run's flight: both feet off the ground
+    body.rotation_euler.z = rad(-lean - (2 if who == "bash" else 0) * math.sin(2 * th))
+    body.location.y = 0.0
+    bpy.context.view_layer.update()  # put the lower foot on the ground: the bob comes from the legs themselves
+    inv = c.root.matrix_world.inverted()
+    low = min((inv @ (f.matrix_world @ v.co)).y for s in (1, -1) for f in [c.extras[f"foot{s}"]] for v in f.data.vertices)
+    body.location.y = -low - 0.02 + lift
+    c.extras["head"].rotation_euler.z = rad(nod * math.sin(2 * th + 0.6))
+    for k, amp in (("tail", 7), ("ear1", 6 if who == "pip" else 3)):
+        o = c.extras.get(k)
+        if o is not None:
+            o.rotation_euler.z = rad((8 if (k == "ear1" and who == "pip") else 0) + amp * math.sin(2 * th + 1.2))
+    if frame is not None:
+        for o in [body, c.extras["head"]] + list(c.legs.values()) + list(c.arms.values()) + list(c.elbows.values()) + \
+                [c.extras[f"knee{s}"] for s in (1, -1)] + [c.extras[f"ankle{s}"] for s in (1, -1)] + \
+                [c.extras[k] for k in ("tail", "ear1") if c.extras.get(k) is not None]:
+            o.keyframe_insert("rotation_euler", frame=frame)
+        body.keyframe_insert("location", frame=frame)
