@@ -0,0 +1,329 @@
+# Side views (profiles) of the cast, for walking and running across the screen. A new addition: the front-view
+# cast in cast.py is untouched. Drawn from the Gemini turnarounds (Porchlight art/gemini/refs/turnaround_*.jpg),
+# in the same style: flat colours, bold outlines, cel shadows. Units match cast.py: feet at y=0, facing +x
+# (set root.scale.x = -1 to face left).
+#
+#   c = profile.make("riot")              # a Character with near/far legs (hip, knee, ankle) and arms (shoulder, elbow)
+#   profile.walk_pose(c, 0.25)            # pose it at a point of the walk cycle (0..1); run=True for the run cycle
+#
+# Rig per character: c.extras["body"], ["head"], ["tail"]; c.legs[1] near / c.legs[-1] far (rotate at the hip,
+# children "knee" and "ankle"); c.arms[1] near / c.arms[-1] far (rotate at the shoulder; c.elbows[s]).
+# Positive rotation swings a limb forward; a positive knee or elbow bends it the natural way.
+import math
+from toon import *
+from toon import _hex_shift
+import cast
+from cast import Character, add_eye, add_brow, capsule
+
+THIGH, SHIN = 1.3, 1.3      # leg parts (hip to knee, knee to ankle): 2.6 like the front view
+UPPER, FORE = 1.35, 1.1     # arm parts
+
+
+def far(h):
+    """The far side's limbs: a shade darker, so the near and far legs read apart (pale fur only a touch, or it
+    goes grey)."""
+    lum = sum(int(h[i:i + 2], 16) for i in (1, 3, 5)) / 765
+    return _hex_shift(h, 0.9 if lum > 0.8 else 0.78)
+
+
+def _leg(c, s, body, fur, foot_len=0.8, z=0.0):
+    col = fur if s == 1 else far(fur)
+    n = f"{c.name}_pleg{s}"
+    hip = empty(n, body, (0.0 if s == 1 else -0.15, 3.2), z)
+    shape(f"{n}_thigh", capsule(0, 0.15, 0, -THIGH, 0.43), col, hip, 0.0)
+    knee = empty(f"{n}_knee", hip, (0, -THIGH), 0.01)
+    shape(f"{n}_shin", capsule(0, 0.1, 0, -SHIN, 0.39), col, knee, 0.0)
+    ank = empty(f"{n}_ankle", knee, (0, -SHIN), 0.02)
+    c.extras[f"foot{s}"] = shape(f"{n}_foot", ell(0.32, -0.27, foot_len, 0.37), col, ank, 0.0)
+    stroke(f"{n}_toe", [(0.75, -0.08), (0.8, -0.42)], 0.05, OUTLINE, ank, 0.01)
+    hip["knee"], hip["ankle"] = knee.name, ank.name
+    c.legs[s] = hip
+    c.extras[f"knee{s}"], c.extras[f"ankle{s}"] = knee, ank
+    return hip
+
+
+def _arm(c, s, body, sleeve, cuff, fur, pipe=None, z=0.0):
+    col, cf, fu = (sleeve, cuff, fur) if s == 1 else (far(sleeve), far(cuff), far(fur))
+    n = f"{c.name}_parm{s}"
+    sh = empty(n, body, (0.05 if s == 1 else -0.1, 6.0), z)
+    shape(f"{n}_upper", capsule(0, 0.15, 0, -UPPER, 0.46), col, sh, 0.0)
+    if pipe and s == 1:
+        stroke(f"{n}_pipe", [(-0.05, 0.1), (-0.08, -1.2)], 0.06, pipe, sh, 0.01)
+    el = empty(f"{n}_elbow", sh, (0, -UPPER), 0.02)
+    shape(f"{n}_fore", capsule(0, 0.15, 0, -FORE, 0.42), col, el, 0.0)
+    shape(f"{n}_cuff", [(-0.44, -0.78), (0.44, -0.78), (0.44, -1.12), (-0.44, -1.12)], cf, el, 0.012, ol=0.05, smooth=0)
+    shape(f"{n}_paw", ell(0.05, -1.45, 0.45, 0.45), fu, el, 0.005)
+    c.arms[s], c.elbows[s] = sh, el
+    return sh
+
+
+def _torso(c, body, color, trim, front=1.3, back=-1.2, string="#FFFFFF", pocket=True):
+    """The hoodie from the side: a rounded block, the hood bunched at the back of the neck, the pocket's edge at
+    the front, a drawstring."""
+    n = c.name
+    pts = [(back + 0.05, 3.05, "s"), (front - 0.05, 3.05, "s"), (front + 0.12, 3.9), (front + 0.15, 5.0),
+           (front, 5.9), (front - 0.35, 6.4), (back + 0.4, 6.45), (back - 0.1, 6.0), (back - 0.12, 4.8), (back - 0.05, 3.8)]
+    shape(f"{n}_ptorso", pts, color, body, 0.0)
+    shape(f"{n}_phem", [(back + 0.08, 3.07, "s"), (front - 0.08, 3.07, "s"), (front + 0.02, 3.45, "s"), (back - 0.02, 3.45, "s")],
+          trim, body, 0.01, ol=0, smooth=0)
+    shape(f"{n}_phood", [(back - 0.35, 6.0), (back - 0.25, 6.75, "s"), (back + 0.5, 7.0), (0.3, 6.7), (0.1, 6.15)],
+          color, body, 0.02)
+    stroke(f"{n}_phood_l", [(back - 0.05, 6.15), (back + 0.35, 6.75)], 0.06, _hex_shift(color, 0.7), body, 0.025)
+    if pocket:
+        stroke(f"{n}_ppocket", [(front - 0.05, 4.55), (front - 0.45, 4.35), (front - 0.55, 3.6)], 0.07, OUTLINE, body, 0.02)
+    stroke(f"{n}_pzip", [(front - 0.02, 3.5), (front + 0.05, 5.8)], 0.06, trim, body, 0.02)
+    stroke(f"{n}_pstring", [(front - 0.3, 6.25), (front - 0.22, 5.45)], 0.07, string, body, 0.03)
+
+
+def _profile_mouths(c, head, pos, w=1.0, inner="#7A1020", tongue="#F0606E", teeth=None):
+    """Mouths seen from the side, one per mouth name the expressions and lip sync use: closed (a smile line, flat,
+    a frown), a little open, wide open. Drawn at the front of the muzzle, opening downward and back."""
+    m = empty(f"{c.name}_pmouth", head, pos, 0.06)
+    s = lambda pts: [(x * w, y * w) + tuple(r) for x, y, *r in pts]
+    kinds = {"smile": "smile", "grin": "open", "smirk": "smile", "grit": "flat", "shock": "wide", "laugh": "wide",
+             "flat": "flat", "wobble": "flat", "yell": "wide", "smug": "smile", "ew": "frown", "pout": "frown",
+             "vA": "flat", "vB": "open", "vC": "open", "vD": "wide", "vE": "open", "vF": "small", "vG": "flat", "vH": "open", "vX": "flat"}
+    for key, kind in kinds.items():
+        g = empty(f"{c.name}_m_{key}", m)
+        c.mouths[key] = g
+        if kind == "smile":
+            stroke(f"{g.name}_l", s([(0.05, 0.05), (-0.25, -0.12), (-0.6, -0.05)]), 0.08, OUTLINE, g, 0.0)
+        elif kind == "flat":
+            stroke(f"{g.name}_l", s([(0.05, -0.02), (-0.55, -0.06)]), 0.08, OUTLINE, g, 0.0)
+        elif kind == "frown":
+            stroke(f"{g.name}_l", s([(0.05, -0.1), (-0.25, 0.0), (-0.55, -0.12)]), 0.08, OUTLINE, g, 0.0)
+        else:
+            d = {"small": 0.18, "open": 0.3, "wide": 0.55}[kind]
+            pts = s([(0.08, 0.02, "s"), (-0.55, -0.02, "s"), (-0.35, -d * 0.9), (-0.05, -d)])
+            shape(f"{g.name}_in", pts, inner, g, 0.0, ol=0.07, smooth=2)
+            if kind != "small":
+                shape(f"{g.name}_tg", s([(-0.4, -d * 0.75), (-0.05, -d * 0.95), (-0.15, -d * 0.55)]), tongue, g, 0.005, ol=0, smooth=2)
+        if teeth and kind != "frown":
+            shape(f"{g.name}_teeth", s([(-0.02, 0.05), (-0.3, 0.05), (-0.28, -0.22), (-0.04, -0.22)]), "#FFFFFF", g, 0.01, ol=0.04, smooth=0)
+        set_visible(g, key == "smile")
+    return m
+
+
+def _head(c, body, y=6.15):
+    head = empty(f"{c.name}_phead", body, (0.15, y), 0.4)
+    c.extras["head"] = head
+    return head
+
+
+def _eye(c, head, pos, rx, ry, pupil_r, lid=True):
+    e = add_eye(c, head, 1, pos, rx, ry, 0.03, pupil_r=pupil_r, lid=lid)
+    side, p = c.pupils[-1]
+    p["x0"] = rx * 0.3  # the pupil sits toward the front of the eye: looking where he's going
+    p.location.x = p["x0"]
+    return e
+
+
+# ---------- Riot ----------
+
+def riot(costume="hoodie"):
+    F, FD, CR, EAR = cast.RIOT_FUR, cast.RIOT_FUR_D, cast.RIOT_CREAM, cast.RIOT_EAR
+    c = Character("riot")
+    body = empty("riot_body", c.root, (0, 0), 0.0)
+    c.extras["body"] = body
+    tail = empty("riot_ptail", body, (-0.85, 3.4), -0.6)
+    tpts = chaikin([(0, -0.35), (-1.3, -0.75), (-2.6, -0.45), (-3.55, 0.45), (-3.95, 1.75), (-3.75, 2.95),
+                    (-3.25, 3.75, "s"), (-3.0, 2.95), (-2.6, 1.85), (-2.05, 1.05), (-1.1, 0.55), (0.0, 0.45)], 3)
+    shape("riot_ptail_fur", tpts, F, tail, 0.0, smooth=0)
+    shape("riot_ptail_tip", cap(tpts, (-3.0, 2.0), (-0.25, 1.0), teeth=3, depth=0.5), CR, tail, 0.01, ol=0, smooth=0)
+    c.extras["tail"] = tail
+    _arm(c, -1, body, cast.CHARCOAL, ORANGE, F, z=-0.45)
+    _leg(c, -1, body, F, z=-0.35)
+    _leg(c, 1, body, F, z=-0.1)
+    shape("riot_pbelly", ell(0.35, 3.1, 0.75, 0.42), CR, body, -0.05)
+    _torso(c, body, cast.CHARCOAL, ORANGE, string=ORANGE)
+    stroke("riot_pseam", [(-0.75, 3.5), (-0.7, 5.0), (-0.45, 6.2)], 0.07, ORANGE, body, 0.02)
+    _arm(c, 1, body, cast.CHARCOAL, ORANGE, F, pipe=ORANGE, z=0.3)
+    head = _head(c, body)
+    far_ear = empty("riot_pear-1", head, (0.35, 2.7), -0.12)
