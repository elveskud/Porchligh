+# Reference sheet for the side views (profile.py): per character, the front view next to the new side view,
+# the walk cycle (8 poses) and the run cycle (4 poses) -> refs/side_<name>.png
+#   Blender --background --python sideref.py        (ONLY=pip for one character)
+import os, sys
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+from toon import *
+import roster, profile
+
+OUT = os.path.join(HERE, "refs")
+ONLY = os.environ.get("ONLY")
+GAP = 7.0
+
+for who in ("riot", "bash", "pip", "rocco"):
+    if ONLY and who != ONLY:
+        continue
+    sc = reset()
+    setup_render(sc, 3200, 2250, bg="#FFFFFF")
+    # row 1: front and side, standing
+    f = roster.make(who)
+    f.root.location = (-GAP * 3.5, 30, 0)
+    s = profile.make(who)
+    s.root.location = (-GAP * 1.6, 30, 0)
+    text("t1", "FRONT", 0.9, "#666666", None, (-GAP * 3.5, 43.0), 1)
+    text("t2", "SIDE (new)", 0.9, "#666666", None, (-GAP * 1.6, 43.0), 1)
+    text("t0", who.upper(), 2.2, "#121212", None, (GAP * 1.5, 36.0), 1)
+    # row 2: walk, 8 poses
+    text("t3", "WALK", 0.9, "#666666", None, (-GAP * 3.5 - 3.6, 20.5), 1)
+    for i in range(8):
+        w = profile.make(who)
+        w.root.location = (-GAP * 3.5 + i * GAP, 15, 0)
+        profile.walk_pose(w, i / 8)
+    stroke("g1", [(-30, 15), (30, 15)], 0.05, "#BBBBBB", None, -1)
+    # row 3: run, 4 poses
+    text("t4", "RUN", 0.9, "#666666", None, (-GAP * 3.5 - 3.6, 5.5), 1)
+    for i in range(4):
