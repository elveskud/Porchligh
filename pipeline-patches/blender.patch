+    ("laugh", "riot", lambda a: M.laugh(a, 2, 40), 12),
+    ("cheer", "bash", lambda a: M.cheer(a, 2), 14),
+    ("nervous", "pip", lambda a: M.nervous(a, 2, 40), 16),
+    ("yell", "bash", lambda a: M.yell(a, 2, 40), 14),
+    ("shrug", "riot", lambda a: M.shrug(a, 2), 12),
+    ("facepalm", "rocco", lambda a: M.facepalm(a, 2), 16),
+    ("wave", "pip", lambda a: M.wave(a, 2, 40), 14),
+    ("thumbs", "riot", lambda a: M.thumbs_up(a, 2), 16),
+    ("present", "riot", lambda a: M.present(a, 2), 16),
+    ("hop", "pip", lambda a: M.hop(a, 2), 9),
+    ("point", "bash", lambda a: M.point_at(a, 2, 1), 16),
+    ("fan", "rocco", lambda a: M.fan(a, 2, 40), 14),
+    ("shiver", "pip", lambda a: M.shiver(a, 2, 40), 14),
+    ("cross", "bash", lambda a: M.cross_arms(a, 2, 60), 30),
+    ("hips", "riot", lambda a: M.hips(a, 2, 40), 25),
+    ("nod", "riot", lambda a: M.nod(a, 2), 6),
+    ("shake", "bash", lambda a: M.head_shake(a, 2), 4),
+    ("clap", "pip", lambda a: M.clap(a, 2, 40), 12),
+    ("count", "riot", lambda a: M.count(a, 2, 3), 40),
+    ("peace", "pip", lambda a: M.sign(a, 2, "peace"), 18),
+    ("horns", "bash", lambda a: M.sign(a, 2, "horns"), 18),
+    ("rock", "riot", lambda a: M.rock_on(a, 2), 18),
+    ("gloom", "bash", lambda a: M.gloom(a, 2, 50), 30),
+    ("yawn", "rocco", lambda a: M.yawn(a, 2), 22),
+    ("stretch", "rocco", lambda a: M.stretch(a, 2), 22),
+    ("scratch", "pip", lambda a: M.scratch(a, 2), 18),
+    ("chuckle", "riot", lambda a: (a.expr(0, "happy"), M.chuckle(a, 2)), 5),
