+# Reference sheet of every move a script can use, each frozen at its peak, on one image (refs/moves_sheet.png).
+#   /Applications/Blender.app/Contents/MacOS/Blender --background --python Blender/characters/movesheet.py
+# Regenerate it after changing or adding a move, and look at it before using the move in an episode.
+import os, sys, subprocess
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+from toon import *
+import motion, roster
+
+OUT = os.path.join(HERE, "refs", "moves")
+os.makedirs(OUT, exist_ok=True)
+motion.RICH = True
+M = motion
+MOVES = [  # (label, who, setup(anim), frame to show)
