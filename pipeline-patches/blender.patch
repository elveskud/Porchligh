+def colour_targets():
+    """"colour": "match" (with "act"): sets lit the same way (day, sunset, night) are nudged toward their shared
+    average colour, so scenes in the same light match from cut to cut. Measured from the paintings themselves."""
+    if not ACT or C.get("colour", "match") != "match":
+        return {}
+    import numpy as np
