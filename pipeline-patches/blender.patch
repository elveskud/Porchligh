+# Clean reference pictures of the cast to hand to Gemini (no text, plain white, big):
+#   refs/gemini/<name>.png        one character, full body, front view
+#   refs/gemini/lineup.png        all four side by side, same scale
+# Run:  Blender --background --python gemini_refs.py
+import os, sys
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+from toon import *
+import roster
+
+OUT = os.path.join(HERE, "refs", "gemini")
+os.makedirs(OUT, exist_ok=True)
+CAST = ["riot", "bash", "pip", "rocco"]
+
+
+def shot(path, who, t=0.0, w=1300, h=1300, ortho=13.0):
+    sc = reset()
+    setup_render(sc, w, h, bg="#FFFFFF")
+    c = roster.make(who)
+    c.expr("happy")
+    c.turn(t)
+    camera(sc, 0.6, 6.0, ortho)
+    still(sc, path, 0)
+
+
+for who in CAST:
+    shot(os.path.join(OUT, f"{who}.png"), who)
+
+sc = reset()
+setup_render(sc, 3000, 1300, bg="#FFFFFF")
+for i, who in enumerate(CAST):
+    c = roster.make(who)
+    c.expr("happy")
+    c.root.location.x = (i - 1.5) * 7.0
+camera(sc, 0.6, 6.0, 13.0)
+still(sc, os.path.join(OUT, "lineup.png"), 0)
+print("gemini refs:", OUT)
