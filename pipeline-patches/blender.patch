+def face_checks(out, mp4):
+    """QA for episodes: every speaker's face on screen while talking, bright enough to read on a phone, and not under
+    the captions. Face positions come from scene.blend; brightness from the finished video's own frames."""
+    script = os.path.join(out, "facecheck.py")
+    open(script, "w").write(FACES_CHECK)
+    p = subprocess.run([BLENDER, "--background", os.path.join(out, "scene.blend"), "--python", script], capture_output=True, text=True)
+    os.remove(script)
+    m = re.search(r"FACES (\[.*\])", p.stdout)
+    if not m:
+        return []
+    faces = json.loads(m.group(1))
+    off = [lid for fr, lid, x, y in faces if not (0.02 < x < 0.98 and 0.05 < y < 0.98)]
+    under = [lid for fr, lid, x, y in faces if 0.02 < x < 0.98 and y < 0.2]  # captions sit in the bottom fifth
+    dark = []
+    try:
+        from PIL import Image
+        tmp = os.path.join(out, "_face.png")
+        for fr, lid, x, y in faces:
+            if lid in off:
+                continue
+            subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{fr / 30:.3f}", "-i", mp4, "-frames:v", "1", tmp], check=True)
+            im = Image.open(tmp).convert("L")
+            W, H = im.size
+            cx, cy, r = int(x * W), int((1 - y) * H), int(0.035 * W)
+            box = im.crop((max(0, cx - r), max(0, cy - r), min(W, cx + r), min(H, cy + r)))
+            px = list(box.getdata())
+            if px and sum(px) / len(px) < 50:
+                dark.append(lid)
+        if os.path.exists(tmp):
+            os.remove(tmp)
