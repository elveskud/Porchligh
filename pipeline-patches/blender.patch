diff --git a/characters/lipsync.py b/characters/lipsync.py
new file mode 100644
index 0000000..a8192fb
--- /dev/null
+++ b/characters/lipsync.py
@@ -0,0 +1,34 @@
+# Rhubarb Lip Sync mouth cues, cached next to each wav. Plain Python (no Blender), so make.py can make every
+# line's cues once before a parallel render, instead of each Blender job running Rhubarb on the same files.
+import json, os, subprocess
+
+RHUBARB = os.path.join(os.path.dirname(os.path.abspath(__file__)), "../tools/Rhubarb-Lip-Sync-1.14.0-macOS/rhubarb")
+
+
+def _atomic_write(path, body):
+    tmp = f"{path}.{os.getpid()}.tmp"
+    with open(tmp, "w") as f:
+        f.write(body)
+    os.replace(tmp, path)  # readers see the old file or the whole new one, never half of it
+
+
+def rhubarb_cues(wav_path, text=None):
+    """Mouth-shape cues [(start_s, 'A'..'H'/'X')] from Rhubarb Lip Sync, cached next to the wav. None if unavailable."""
+    cache = wav_path + ".rhubarb.json"
+    if not os.path.exists(cache) or os.path.getmtime(cache) < os.path.getmtime(wav_path):
+        if not os.path.exists(RHUBARB):
+            return None
+        tmp = f"{cache}.{os.getpid()}.tmp"
+        cmd = [RHUBARB, "-q", "-f", "json", "--extendedShapes", "GHX", "-o", tmp]
+        if text:
+            tf = wav_path + ".txt"
+            _atomic_write(tf, text)
+            cmd += ["-d", tf]
+        try:
+            subprocess.run(cmd + [wav_path], check=True, capture_output=True)
+            os.replace(tmp, cache)
+        except (OSError, subprocess.CalledProcessError):
+            if os.path.exists(tmp):
+                os.remove(tmp)
+            return None
+    return [(c["start"], c["value"]) for c in json.load(open(cache))["mouthCues"]]
